default_platform(:android)

platform :android do
  desc "Upload metadata, screenshots, and graphics to Google Play Store"
  lane :upload_metadata do
    supply(
      package_name: "com.arcane.dndai.dnd_ai",
      json_key: "fastlane/play-store-key.json",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Deploy signed release App Bundle to Google Play internal track"
  lane :deploy_internal do
    upload_to_play_store(
      track: "internal",
      package_name: "com.arcane.dndai.dnd_ai",
      json_key: "fastlane/play-store-key.json",
      aab: "build/app/outputs/bundle/release/app-release.aab"
    )
  end

  desc "Deploy signed release App Bundle to Google Play production track"
  lane :deploy_production do
    upload_to_play_store(
      track: "production",
      package_name: "com.arcane.dndai.dnd_ai",
      json_key: "fastlane/play-store-key.json",
      aab: "build/app/outputs/bundle/release/app-release.aab"
    )
  end
end
